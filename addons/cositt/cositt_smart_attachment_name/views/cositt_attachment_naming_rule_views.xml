<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cositt_attachment_naming_rule_list" model="ir.ui.view">
        <field name="name">cositt.attachment.naming.rule.list</field>
        <field name="model">cositt.attachment.naming.rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de nombrado de adjuntos">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="pattern"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_cositt_attachment_naming_rule_form" model="ir.ui.view">
        <field name="name">cositt.attachment.naming.rule.form</field>
        <field name="model">cositt.attachment.naming.rule</field>
        <field name="arch" type="xml">
            <form string="Regla de nombrado de adjuntos">
                <sheet>
                    <group>
                        <field name="name" placeholder="Facturas"/>
                        <field name="model_id"/>
                        <field name="pattern" placeholder="Factura_{name}_{partner_id.name}"/>
                        <field name="active"/>
                    </group>
                    <div class="text-muted">
                        Usa {campo} o {campo.subcampo} para insertar datos del
                        registro (por ejemplo {name}, {partner_id.name},
                        {invoice_date}). La extensión del archivo (.pdf, .jpg...)
                        se conserva siempre. Si un campo no existe o está vacío,
                        simplemente se omite.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cositt_attachment_naming_rule" model="ir.actions.act_window">
        <field name="name">Nombrado de adjuntos (Cositt)</field>
        <field name="res_model">cositt.attachment.naming.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cositt_attachment_naming_rule"
              name="Nombrado de adjuntos (Cositt)"
              parent="base.menu_custom"
              action="action_cositt_attachment_naming_rule"
              sequence="60"/>

</odoo>
