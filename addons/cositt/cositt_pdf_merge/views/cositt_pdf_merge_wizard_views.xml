<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cositt_pdf_merge_wizard_form" model="ir.ui.view">
        <field name="name">cositt.pdf.merge.wizard.form</field>
        <field name="model">cositt.pdf.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Combinar PDF">
                <field name="state" invisible="1"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>

                <group invisible="state != 'select'">
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="selected"/>
                            <field name="name" readonly="1"/>
                            <field name="attachment_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="result_filename"/>
                    <field name="attach_to_record"/>
                </group>

                <group invisible="state != 'done'">
                    <field name="result_filename" invisible="1"/>
                    <field name="result_pdf" filename="result_filename" readonly="1"/>
                </group>

                <footer>
                    <button
                        string="Generar PDF"
                        type="object"
                        name="action_generate_pdf"
                        class="btn-primary"
                        invisible="state != 'select'"
                    />
                    <button
                        string="Cancelar"
                        special="cancel"
                        invisible="state != 'select'"
                    />
                    <button
                        string="Cerrar"
                        special="cancel"
                        class="btn-primary"
                        invisible="state != 'done'"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
