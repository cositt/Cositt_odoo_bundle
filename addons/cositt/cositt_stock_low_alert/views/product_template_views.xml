<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_template_form_inherit_low_stock_alert" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cositt.low.stock.alert</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <!-- Ancla a "group_lots_and_weight" (grupo nativo con nombre
                 fijo, siempre presente para productos de tipo Goods) en
                 vez de una posición ("group[1]") o del <page> genérico:
                 otros módulos insertan grupos antes/después de forma
                 dinámica, así que un índice posicional no es estable
                 (verificado: un 3er <group> hermano añadido al final de
                 la página no llegaba a pintarse). -->
            <xpath expr="//group[@name='group_lots_and_weight']" position="inside">
                <field name="low_stock_threshold"/>
                <field name="is_low_stock" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
