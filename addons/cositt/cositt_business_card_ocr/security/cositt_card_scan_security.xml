<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cositt_card_scan_rule_own" model="ir.rule">
        <field name="name">Escaneos de tarjeta: solo los propios</field>
        <field name="model_id" ref="model_cositt_card_scan"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="cositt_card_scan_rule_admin" model="ir.rule">
        <field name="name">Escaneos de tarjeta: administradores ven todos</field>
        <field name="model_id" ref="model_cositt_card_scan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

</odoo>
