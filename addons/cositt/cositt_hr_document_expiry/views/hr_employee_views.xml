<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_inherit_document_expiry" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.cositt.document.expiry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Ancla a la última página nativa ("hr_settings"), como
                 hacen otros módulos core (hr_org_chart, hr_skills) que
                 también añaden páginas aquí, en vez del <notebook>
                 genérico (más frágil ante colisiones de orden). -->
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Documents" name="cositt_documents">
                    <field name="document_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="expiry_date"/>
                            <field name="reminder_days_before"/>
                            <field name="state" widget="badge"
                                   decoration-danger="state == 'expired'"
                                   decoration-warning="state == 'expiring_soon'"
                                   decoration-success="state == 'valid'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
