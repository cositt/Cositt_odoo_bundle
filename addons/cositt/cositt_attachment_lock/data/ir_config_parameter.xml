<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="1": si un administrador lo cambia a True desde Ajustes >
        Técnico > Parámetros del sistema, una futura actualización del
        módulo no debe pisar ese valor.
    -->
    <data noupdate="1">
        <record id="config_parameter_enabled" model="ir.config_parameter">
            <field name="key">cositt_attachment_lock.enabled</field>
            <field name="value">False</field>
        </record>
    </data>
</odoo>
