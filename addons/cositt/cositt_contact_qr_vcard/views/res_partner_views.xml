<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_qr_vcard" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.cositt.qr.vcard</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Solo hay un <notebook> en esta vista base (verificado). -->
            <xpath expr="//notebook" position="inside">
                <page string="Digital Card" name="cositt_qr_vcard">
                    <group>
                        <field name="qr_vcard" widget="image" nolabel="1"
                               class="oe_avatar"
                               options="{'size': [256, 256]}"/>
                        <p class="text-muted">
                            Scan this code with a phone camera to add this
                            contact directly to the address book.
                        </p>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
