<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cositt_mass_edit_enabled_model_list" model="ir.ui.view">
        <field name="name">cositt.mass.edit.enabled.model.list</field>
        <field name="model">cositt.mass.edit.enabled.model</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="model_id" options="{'no_open': True}"/>
                <field name="model_name"/>
            </list>
        </field>
    </record>

    <record id="action_cositt_mass_edit_enabled_model" model="ir.actions.act_window">
        <field name="name">Edición masiva</field>
        <field name="res_model">cositt.mass.edit.enabled.model</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Añade un modelo para habilitar "Edición masiva" en su vista de lista.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_cositt_mass_edit_enabled_model"
        name="Edición masiva"
        action="action_cositt_mass_edit_enabled_model"
        parent="base.menu_custom"
        sequence="30"
        groups="base.group_system"
    />

</odoo>
