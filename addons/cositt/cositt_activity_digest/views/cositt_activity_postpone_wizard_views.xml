<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cositt_activity_postpone_wizard_form" model="ir.ui.view">
        <field name="name">cositt.activity.postpone.wizard.form</field>
        <field name="model">cositt.activity.postpone.wizard</field>
        <field name="arch" type="xml">
            <form string="Posponer actividades">
                <field name="activity_ids" invisible="1"/>
                <p>
                    Vas a posponer
                    <field name="activity_count" nolabel="1" class="oe_inline"/>
                    actividad(es) seleccionada(s).
                </p>
                <group>
                    <field name="days"/>
                </group>
                <footer>
                    <button
                        string="Posponer"
                        type="object"
                        name="action_postpone"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
