<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cositt.user.avatar.style</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cositt - Avatares" string="Cositt - Avatares" name="cositt_user_avatar_style"
                     groups="base.group_system">
                    <block title="Paleta de marca para avatares" name="cositt_avatar_style_setting_container">
                        <setting id="cositt_avatar_style_setting"
                                 help="Aplica a cualquier avatar generado automáticamente (contactos, empleados...) sin foto propia. No afecta a quien ya tiene una foto subida.">
                            <field name="cositt_avatar_style_enabled"/>
                            <div class="content-group" invisible="not cositt_avatar_style_enabled">
                                <div class="row mt16">
                                    <label for="cositt_avatar_style_palette" string="Colores" class="col-lg-3 o_light_label"/>
                                    <field name="cositt_avatar_style_palette" placeholder="#714b67, #1e7d3c, #5b6bc0"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
